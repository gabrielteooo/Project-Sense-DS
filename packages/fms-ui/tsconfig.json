{
  "compilerOptions": {
    "types": ["@figma/code-connect/figma-types"],
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@fms-tokens/*": ["../../tokens/*"],
      "@fms/ui": ["./src/index.ts"]
    }
  },
  "include": ["src", "src/**/*.figma.ts", ".storybook"]
}
